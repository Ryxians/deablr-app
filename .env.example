# Secret used to sign sessions. Required in production.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the site (e.g. https://deablr.example.com). Optional:
# when unset, the origin is derived from each incoming request, which is
# correct for this same-origin app. Set in production to pin it explicitly.
# BETTER_AUTH_URL=

# Optional overrides
# DB_PATH=data/deablr.db
# MIGRATIONS_FOLDER=drizzle
